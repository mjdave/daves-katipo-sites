dictionary = require("dictionary.jsonl")
dictionary400kWordsList = require("words_dictionary.json")

allowedCharsList = {
    "Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P", "A", "S", "D", "F", "G", "H", "J", "K", "L", "Z", "X", "C", "V", "B", "N", "M"
}

allowedChars = {}
for(char in allowedCharsList)
{
    allowedChars[string.lower(char)] = true
}

validWords = {}

for(v in dictionary)
{
    word = v.word
    if(word)
    {
        word = string.lower(word)
        wordLength = string.length(word)
        if(wordLength == 4)
        {
            word = word + "s"
            print("testing plural:", word)
            if(dictionary400kWordsList[word])
            {
                print("word is valid")
            }
            else
            {
                print("not a word")
                word = nil
            }
        }
        else if(wordLength != 5)
        {
            word = nil
        }
    }

    if(word)
    {
        validWord = true

        charFunc = function(char)
        {
            if(!allowedChars[char])
            {
                .validWord = false
                return true
            }
            return false
        }
        string.eachChar(word, charFunc)

        if(validWord)
        {
            wordDefinitions = validWords[word]
            if(!wordDefinitions)
            {
                wordDefinitions = {}
                validWords[word] = wordDefinitions
            }
            if(table.count(wordDefinitions) < 4)
            {
                table.insert(wordDefinitions, v.definition)
            }
        }
    }
}

wordsArray = {}
for(word, definitions in validWords)
{
    wordInfo = {
        w = word
        d = definitions
    }
    table.insert(wordsArray, wordInfo)
}

file.save("/Users/davidframpton/Documents/daves-katipo-sites/wordee/words.tui", wordsArray)