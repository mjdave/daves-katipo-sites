#global katipo
#global scene
#global time
#global eventManager
#global database

printCheatWord = false

keys = require("app/common/keys.tui")
highScores = require("scripts/highScores.tui")
words = require("scripts/words.tui")

validWords = {}
for(word in words)
{
    validWords[word.w] = true
}

gameView = scene.getView("gameView")

gameRunning = true

runningInTheBackground = false

mostRecentCompletedIndex = false

secondsBetweenWords = 60 * 60 * 12
prevTimeUpdateSeconds = false

enterChar = function(newChar)
{
    if(mostRecentCompletedIndex)
    {
        return
    }
    key = "key_" + string.upper(newChar)
    keyButton = gameView.getView(key)
    if(!keyButton or keyButton.disabled)
    {
        return
    }

    tryIndex = database.get("tryIndex")
    currentTry = database.get("try_" + tryIndex)
    if(!currentTry)
    {
        currentTry = ""
    }

    currentLength = string.length(currentTry)
    if(currentLength < 5)
    {
        currentTry += string.lower(newChar)
        database.set("try_" + tryIndex, currentTry)
        squareKey = "square_" + tryIndex + "_" + currentLength
        squareView = gameView.getView(squareKey)
        squareView.color = scene.squareSetColor
        
        textView = squareView.getView("text")
        textView.text = string.upper(newChar)

        if(currentLength == 4)
        {
            if(validWords[currentTry])
            {
                key = "key_>"
                keyButton = gameView.getView(key)
                keyButton.setDisabled(false)
            }  
        }
        else
        {
            squareKey = "square_" + tryIndex + "_" + (currentLength + 1)
            squareView = gameView.getView(squareKey)
            squareView.color = scene.squareSelectedColor
        }
    }
}

confirmPressed = function()
{
    currentInProgressWordIndex = database.get("currentInProgressIndex")
    tryIndex = database.get("tryIndex")
    currentTry = database.get("try_" + tryIndex)
    if(!currentTry)
    {
        currentTry = ""
    }

    currentLength = string.length(currentTry)
    if(currentLength == 5)
    {
        if(validWords[currentTry])
        {
            scoreColorGrid = database.get("scoreColorGrid")

            todaysWord = words[currentInProgressWordIndex]

            scoreColors = {}
            table.insert(scoreColorGrid, scoreColors)
            for(charIndex = 0, charIndex < 5, charIndex++)
            {
                thisChar = string.subString(currentTry, charIndex, 1)

                squareKey = "square_" + tryIndex + "_" + charIndex
                squareView = gameView.getView(squareKey)
                textView = squareView.getView("text")

                key = "key_" + string.upper(thisChar)
                keyButton = gameView.getView(key)

                foundLocation = string.find(todaysWord.w, thisChar)
                if(foundLocation)
                {
                    thisLocation = string.find(todaysWord.w, thisChar, charIndex)
                    if(thisLocation == charIndex)
                    {
                        squareView.color = vec4(0,1,0,0.6)
                        table.insert(scoreColors, 1)
                    }
                    else
                    {
                        squareView.color = vec4(1,1,0,0.6)
                        table.insert(scoreColors, 2)
                    }
                    keyButton.setColor(squareView.color)
                }
                else
                {
                    squareView.color = vec4(0,0,0,0.2)
                    textView.color = vec4(1,1,1,0.4)
                    keyButton.setColor(vec4(0,0,0,0.5))
                    textView = keyButton.getView("text")
                    textView.color = vec4(1,1,1,0.3)
                    table.insert(scoreColors, 0)
                }
            }

            database.set("scoreColorGrid", scoreColorGrid)

            if(currentTry == todaysWord.w)
            {
                #game won
                .mostRecentCompletedIndex = database.get("currentInProgressIndex")
                database.set("mostRecentCompletedIndex", mostRecentCompletedIndex)
                database.remove("currentInProgressIndex")
                highScores.showHighScoresAfterGame(tryIndex, 
                    scoreColorGrid
                    todaysWord, 
                    mostRecentCompletedIndex, 
                    gameView)
            }
            else
            {
                tryIndex++
                database.set("tryIndex", tryIndex)

                if(tryIndex == 8)
                {
                    .mostRecentCompletedIndex = database.get("currentInProgressIndex")
                    database.set("mostRecentCompletedIndex", mostRecentCompletedIndex)
                    database.remove("currentInProgressIndex")
                    highScores.showHighScoresAfterGame(tryIndex, 
                        scoreColorGrid
                        todaysWord,
                        mostRecentCompletedIndex, 
                        gameView)
                }
                else
                {
                    addSquareViews(tryIndex)

                    database.set("try_" + tryIndex, "")
                    key = "key_>"
                    keyButton = gameView.getView(key)
                    keyButton.setDisabled(true)

                    squareView = gameView.getView("square_" + tryIndex + "_0")
                    squareView.color = scene.squareSelectedColor
                }
            }
        }
    }
}

deleteCurrentChar = function()
{
    tryIndex = database.get("tryIndex")
    currentTry = database.get("try_" + tryIndex)
    if(!currentTry)
    {
        return
    }
    currentLength = string.length(currentTry)
    if(currentLength > 0)
    {
        if(currentLength < 5)
        {
            squareKey = "square_" + tryIndex + "_" + currentLength
            squareView = gameView.getView(squareKey)
            squareView.color = scene.squareBackgroundColor
        }

        squareKey = "square_" + tryIndex + "_" + (currentLength - 1)
        squareView = gameView.getView(squareKey)
        squareView.color = scene.squareSelectedColor

        textView = squareView.getView("text")
        textView.text = ""
        currentTry = string.subString(currentTry, 0, currentLength - 1)
        database.set("try_" + tryIndex, currentTry)

        if(currentLength == 5)
        {
            key = "key_>"
            keyButton = gameView.getView(key)
            keyButton.setDisabled(true)
        }
    }
}

keyClickFunction = function(keyView)
{
    if(keyView.keyChar == "<")
    {
        deleteCurrentChar()
    }
    else if(keyView.keyChar == ">")
    {
        confirmPressed()
    }
    else
    {
        enterChar(keyView.keyChar)
    }
}

addSquareViews = function(rowIndex)
{
    gridCellSize = scene.gridCellSize
    padding = scene.padding
    gridView = gameView.getView("grid")

    gridView.size = vec2(scene.gridBackgroundSize.x, (gridCellSize + padding) * (rowIndex + 1) + padding)

    for(x = 0, x < 5, x++)
    {
        yOffsetIndex = -rowIndex
        squareViewLayout = {
            id = "square_" + rowIndex + "_" + x
            type = "color"
            alignmentY = "top"
            alignmentX = "left"
            size = vec2(gridCellSize,gridCellSize)
            color = scene.squareBackgroundColor
            pos = vec2(padding + (gridCellSize + padding) * x, -padding + (gridCellSize + padding) * yOffsetIndex)
            subviews = {
                {
                    id = "text"
                    type = "text"
                    font = "robotoBold"
                    fontSize = 30
                }
            }
        }

        squareView = gridView.addView(squareViewLayout)

        table.insert(gridView.squareViews, squareView)
    }
}

clearBoard = function()
{
    tryIndex = database.get("tryIndex")
    scoreColorGrid = database.get("scoreColorGrid")

    print("tryIndex:", tryIndex)
    print("scoreColorGrid:", scoreColorGrid)

    selectionSet = false
    charColors = {}

    gridView = gameView.getView("grid")

    if(gridView.squareViews)
    {
        for(squareView in gridView.squareViews)
        {
            gridView.removeView(squareView)
        }
    }
    gridView.squareViews = {}

    for(y = 0, y < 8, y++)
    {
        addSquareViews(y)

        tryWord = false
        if(tryIndex and tryIndex >= y)
        {
            tryWord = database.get("try_" + y)
        }

        print("y:", y, " tryWord:", tryWord)

        for(x = 0, x < 5, x++)
        {
            key = "square_" + y + "_" + x
            squareView = gameView.getView(key)
            squareView.color = scene.squareBackgroundColor
            textView = squareView.getView("text")
            textView.text = ""
            textView.color = vec4(1,1,1,1)

            if(tryWord and string.length(tryWord) > x)
            {
                char = string.subString(tryWord, x, 1)
                textView.text = string.upper(char)

                if(string.length(tryWord) < 5)
                {
                    squareView.color = scene.squareSetColor
                }
                else
                {
                    scoreColorGridRow = scoreColorGrid[y]
                    color = scoreColorGridRow[x]
                    charColors[char] = color
                    if(color == 1)
                    {
                        squareView.color = vec4(0,1,0,0.6)
                    }
                    else if(color == 2)
                    {
                        squareView.color = vec4(1,1,0,0.6)
                    }
                    else
                    {
                        squareView.color = vec4(0,0,0,0.2)
                        textView.color = vec4(1,1,1,0.4)
                    }
                }
            }
            else if(!selectionSet)
            {
                squareView.color = scene.squareSelectedColor
                .selectionSet = true
            }
        }

        if(selectionSet)
        {
            break
        }
    }

    for(y = 0, y < 3, y++)
    {
        row = scene.keyboardKeys[y]
        for(x, char in row)
        {
            if(char != ">")
            {
                key = "key_" + char
                keyButton = gameView.getView(key)
                charColorIndex = charColors[string.lower(char)]
                if(charColorIndex)
                {
                    if(charColorIndex == 0)
                    {
                        keyButton.setColor(vec4(0,0,0,0.5))
                    }
                    else if(charColorIndex == 1)
                    {
                        keyButton.setColor(vec4(0,1,0,0.6))
                    }
                    else if(charColorIndex == 2)
                    {
                        keyButton.setColor(vec4(1,1,0,0.6))
                    }
                }
                else
                {
                    keyButton.setColor(scene.squareBackgroundColor)
                }
                textView = keyButton.getView("text")
                textView.color = vec4(1,1,1,1)
            }
        }
    }
}

getTodaysIndex = function()
{
    nowTime = time.now()
    return math.randomInt(table.count(words), math.floor(nowTime / secondsBetweenWords))
}

katipo.onSiteLoad = function(wasNewDownload, publicData) #wasNewDownload if we just pulled an update of the site. false if we are running from the cache, but now have a connection
{
    .runningInTheBackground = false
    #print("in clientSite onSiteLoad:", publicData)
    if(publicData)
    {
        for(k, v in publicData)
        {
            database.set(k, v)
        }
    }

    .mostRecentCompletedIndex = database.get("mostRecentCompletedIndex")

    for(y = 0, y < 3, y++)
    {
        row = scene.keyboardKeys[y]
        for(x, char in row)
        {
            key = "key_" + char
            keyButton = gameView.getView(key)
            keyButton.keyChar = char
            keyButton.setClickFunction(keyClickFunction)

            if(char == ">")
            {
                keyButton.setDisabled(true)
                keyButton.setColor(vec4(0.1,1.0,0.1,0.67))
            }
        }
    }

    clearBoard()

    todaysIndex = getTodaysIndex()
    if(highScores.checkHasCompleted(todaysIndex))
    {
        highScores.showHighScores(words[todaysIndex], todaysIndex, gameView)
    }
    else
    {
        highScores.fadeOut(gameView)
    }
}

katipo.onBackgroundChange = function(isBackground) #called if the app enters the background, or a new site is loaded and we are hidden
{
    .runningInTheBackground = isBackground
}



katipo.update = function(dt) #called every rendered frame, the variable time step is stored in dt
{
    if(!gameRunning or runningInTheBackground or katipo.paused)
    {
        return
    }

    nowTime = time.now()
    secondsUntilNext = secondsBetweenWords - math.floor(nowTime % secondsBetweenWords)

    if(secondsUntilNext != prevTimeUpdateSeconds)
    {
        #print("update")
        .prevTimeUpdateSeconds = secondsUntilNext
        todaysIndex = getTodaysIndex()

        if(mostRecentCompletedIndex != todaysIndex)
        {
            #print("mostRecentCompletedIndex:", mostRecentCompletedIndex, " != todaysIndex:", todaysIndex)

            #print("currentInProgressIndex:", database.get("currentInProgressIndex"))
            
            if(database.get("currentInProgressIndex") != todaysIndex)
            {
                existingScore = highScores.checkHasCompleted(todaysIndex)

                if(existingScore)
                {
                    .mostRecentCompletedIndex = todaysIndex
                    database.set("mostRecentCompletedIndex", todaysIndex)

                    timeUntilNextText = scene.getView("timeUntilNextText")
                    timeUntilNextText.text = ""
                    highScores.showHighScores(words[todaysIndex], todaysIndex, gameView)
                }
                else
                {
                    database.set("currentInProgressIndex", todaysIndex)
                    database.remove("mostRecentCompletedIndex")
                    .mostRecentCompletedIndex = false
                    if(printCheatWord)
                    {
                        print("today's word:", words[todaysIndex])
                    }

                    tryIndex = 0
                    database.set("tryIndex", tryIndex)
                    database.set("try_" + tryIndex, "")
                    database.set("scoreColorGrid", {})

                    clearBoard()

                }
            }
        }
        else
        {
            timeUntilNextText = scene.getView("timeUntilNextText")
            timeUntilNextText.text = string.format("%d:%d%d:%d%d", 
            (math.floor(secondsUntilNext / 3600)),
            (math.floor(secondsUntilNext / 60 % 60 / 10)) //10 minutes
            (math.floor(secondsUntilNext / 60) % 10) // minute
            (math.floor((secondsUntilNext % 60) / 10)), //10 second
            (secondsUntilNext % 10)) #00:X0:00
        }
    }
}

keyEvent = function(isDown, keyCode, modKey, isRepeat)
{
    if(isDown and !isRepeat and !mostRecentCompletedIndex)
    {
        if(keyCode == keys.keyCodes.backspace)
        {
            deleteCurrentChar()
        }
        else if(keyCode == keys.keyCodes.enter or keyCode == keys.keyCodes.key_return)
        {
            confirmPressed()
        }
    }
}

textEntry = function(text)
{
    #print("text entry:", text)

    string.eachChar(text, enterChar)
}

if(platform() != "ios")
{
    eventManager.eventManager.setTextEntryListener(textEntry, keyEvent)
}

highScores.fadeIn()