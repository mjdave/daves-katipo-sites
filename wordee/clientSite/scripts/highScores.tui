{
    print("in checkHasCompleted")
    thisIndex = todaysIndex_
    unsentScore = database.get("unsentScore_" + thisIndex)
    if(unsentScore)
    {
    print("unsentScore")
        scoreSentFunction = function(result)
        {
            database.remove("unsentScore_" + thisIndex)
            database.set("sentScore_" + thisIndex, unsentScore)
        }

        katipo.get("setScore", unsentScore, scoreSentFunction)
        return true
    }

    print("result:", (database.get("sentScore_" + thisIndex) != nil))

    return (database.get("sentScore_" + thisIndex) != nil)
}

showHighScoresAfterGame = function(newScore, scoreColorGrid, todaysWord, todaysIndex_, fadeFromView, completionFunction)
{
    .todaysIndex = todaysIndex_
    databaseKey = "highScores_" + todaysIndex
    scores = database.get(databaseKey)
    if(!scores)
    {
        scores = {}
    }

    enterHighScoreText.hidden = false
    enterHighScoreText.setText("Player 1")
    enterHighScoreText.textEntryClickFunction()
    highScoresTitle.text = string.upper(todaysWord)
    highScoreContentView.hidden = true
    enterHighScoreText.onFinishedEditing = function(textValue, changesMade)
    {
        addIndex = 0
        for(i, scoreInfo in scores)
        {
            if(scoreInfo.score > newScore)
            {
                break
            }
            addIndex++
        }

        name = textValue
        if(!name or name == "")
        {
            name = "bob"
        }

        newScoreInfo = {
            score = newScore,
            scoreColorGrid = scoreColorGrid,
            name = textValue
        }

        table.insert(scores, addIndex, newScoreInfo)

        .mostRecentScoreIndex = addIndex

        database.set(databaseKey, scores)

        #print("newScoreInfo:", newScoreInfo)

        database.set("unsentScore_" + todaysIndex, newScoreInfo)

        newScoreInfo.dayIndex = todaysIndex

        scoreSentFunction = function(result)
        {
            database.remove("unsentScore_" + todaysIndex)
            database.set("sentScore_" + todaysIndex, newScoreInfo)
            print("in score sent function")
        }

            print("setting score")
        katipo.get("setScore", newScoreInfo, scoreSentFunction)

        enterHighScoreText.hidden = true

        updateHighScores()

        highScoreContentView.hidden = false
    }

    fadeIn(fadeFromView, completionFunction)
}

getHidden = function()
{
    return highScoresView.hidden
}