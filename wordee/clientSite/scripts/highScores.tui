#global database
#global scene
#global katipo

maxHighScores = 10
todaysIndex = false

highScoresView = scene.getView("highScores")
highScoreContentView = highScoresView.getView("highScoreContent")
enterHighScoreText = highScoresView.getView("enterHighScoreText")
highScoresTitle = highScoresView.getView("highScoresTitle")

mostRecentScoreIndex = false

crossFade = function(viewFrom, viewTo, completionFunction)
{
    if(viewFrom)
    {
        viewFrom.update = function(dt)
        {
            viewFrom.alpha -= dt
            if(viewFrom.alpha <= 0)
            {
                viewFrom.hidden = true
                viewFrom.alpha = 1.0
                viewFrom.update = nil
            }
        }
    }
    viewTo.hidden = false
    viewTo.alpha = 0.0
    viewTo.update = function(dt)
    {
        viewTo.alpha += dt
        if(viewTo.alpha >= 1.0)
        {
            viewTo.alpha = 1.0
            viewTo.update = nil
            if(completionFunction)
            {
                completionFunction()
            }
        }
    }
}

rowHeight = 50

scoreViewLayout = {
    type = "view"
    alignmentY = "top"
    size = vec2(360,rowHeight)
    subviews = {
        {
            id = "number"
            type = "text"
            alignmentX = "left"
            #pos = vec2(0, 0)
            font = "robotoBold"
            fontSize = 24
            color = vec4(1,1,1,1)
            additiveBlend = true
        }
        {
            id = "colorGrid"
            type = "view"
            layoutParentID = "number"
            alignmentX = "outerRight"
            pos = vec2(10,0)
            size = vec2(rowHeight,rowHeight)
        }
        {
            id = "name"
            type = "text"
            layoutParentID = "colorGrid"
            alignmentX = "outerRight"
            pos = vec2(10,0)
            font = "robotoBold"
            fontSize = 24
            color = vec4(1,1,1,1)
            additiveBlend = true
        }
    }
}

colors = {
    vec4(0.2,0.1,0.1,0.5)
    vec4(0.0,1.0,0.0,1.0)
    vec4(1.0,1.0,0.0,1.0)
}


constructColorGrid = function(parentView, scoreColorGrid)
{
    rowCount = table.count(scoreColorGrid)
    gridHeight = rowHeight - 2
    cellSize = gridHeight / rowCount - 2

    top = -1 #gridHeight * 0.5 - 1

    for(rowIndex, colorIndexes in scoreColorGrid)
    {
        for(i, colorIndex in colorIndexes)
        {
            colorCellLayout = {
                type = "color"
                alignmentX = "left"
                alignmentY = "top"
                size = vec2(cellSize,cellSize)
                color = colors[colorIndex]
                pos = vec2(i * (cellSize + 2), top - rowIndex * (cellSize + 2))
            }
            parentView.addView(colorCellLayout)
        }
    }

    parentView.size = vec2(5 * (cellSize + 2), rowHeight)
}

updateHighScores = function()
{
    if(!todaysIndex)
    {
        return
    }
    scores = database.get("highScores_" + todaysIndex)

    if(highScoreContentView.listView)
    {
        highScoreContentView.removeView(highScoreContentView.listView)
    }

    if(scores and table.count(scores) > 0)
    {
        listView = highScoreContentView.addView({type = "view"})
        highScoreContentView.listView = listView
        
        for(i, scoreInfo in scores)
        {
            scoreViewLayout.pos = vec2(0, -(i * rowHeight))
            //yOffset = -rowHeight -i * rowHeight - 100
            scoreView = listView.addView(scoreViewLayout)

            numberTextView = scoreView.getView("number")
            numberTextView.text = (i + 1) + ". "

            nameTextView = scoreView.getView("name")
            nameTextView.text = string.upper(scoreInfo.name)

            colorGridView = scoreView.getView("colorGrid")
            constructColorGrid(colorGridView, scoreInfo.scoreColorGrid)

            if(i == mostRecentScoreIndex)
            {
                nameTextView.color = vec4(1.0,0.9,0.05,1.5)
                numberTextView.color = vec4(1.0,0.9,0.05,1.5)
            }
            

            if(i == maxHighScores - 1)
            {
                break
            }
        }
    }
}


fadeIn = function(fadeFromView, completionFunction)
{
    updateHighScores()
    crossFade(fadeFromView, highScoresView, completionFunction)
}

fadeOut = function(fadeToView, completionFunction)
{
    crossFade(highScoresView, fadeToView, completionFunction)
}

showHighScores = function(todaysWord, todaysIndex_, fadeFromView, completionFunction)
{
    .todaysIndex = todaysIndex_
    highScoresTitle.text = string.upper(todaysWord)
    
    enterHighScoreText.hidden = true

    updateHighScores()

    highScoreContentView.hidden = false
    
    fadeIn(fadeFromView, completionFunction)
}

