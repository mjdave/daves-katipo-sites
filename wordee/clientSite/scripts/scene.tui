viewTypes = { #can be added to at any time
    button = require("app/common/button.tui")
    textEntry = require("app/common/textEntry.tui")
    scrollView = require("app/common/scrollView.tui")
    fileBrowser = require("app/common/fileBrowser.tui")
}


gridCellSize = 60
padding = 2


gridBackgroundSize = vec2((gridCellSize + padding)*5 + padding,(gridCellSize + padding) + padding) #height is resized dynamically

gridBackgroundColor = vec4(0,0,1,0.2)
squareBackgroundColor = vec4(0.5,0.5,0.5,0.2)
squareSelectedColor = vec4(0.5,0.7,0.7,0.4)
squareSetColor = vec4(0,0.5,0.5,0.2)

titleSquareViews = {}
for(x = 0, x < 5, x++)
{
    squareView = {
        id = "titleSquare_" + x
        type = "color"
        alignmentX = "left"
        size = vec2(gridCellSize,gridCellSize)
        color = squareBackgroundColor
        pos = vec2(padding + (gridCellSize + padding) * x, 0)
        subviews = {
            {
                id = "text"
                type = "text"
                font = "robotoBold"
                fontSize = 30
            }
        }
    }
    table.insert(titleSquareViews, squareView)
}

highScoresView = {
    id = "highScores"
    type = "view"
    hidden = true
    subviews = {
        {
            id = "highScoresTitle"
            type = "view"
            alignmentY = "top"
            pos = vec3(0,-20, 0)
            size = vec2((gridCellSize + padding) * 5 + padding, gridCellSize)
            subviews = titleSquareViews
        }

        {
            id = "highScoresDefinition"
            type = "text"
            alignmentY = "below"
            layoutParentID = "highScoresTitle"
            font = "roboto"
            fontSize = 18
            color = vec4(1.0,1.0,1.0,1.0)
            pos = vec3(0,-20, 0)
            onParentSizeChanged = function(parentSize)
            {
                return vec2(parentSize.x - 40, parentSize.y)
            }
        }

        {
            id = "enterHighScoreText"
            type = "textEntry"
            font = "robotoBold"
            fontSize = 48
            maxChars = 8
            backgroundColor = vec4(0.5,0.0,1.0,0.2)
            hidden = true
        }
        {
            id = "highScoreContent"
            type = "view"
            alignmentY = "below"
            layoutParentID = "highScoresDefinition"
            pos = vec3(0,-20, 0)
        }

        {
            id = "timeUntilNextText"
            type = "text"
            font = "robotoBold"
            fontSize = 20
            alignmentY = "bottom"
            pos = vec2(0,50)
        }
    }
}

keyboardKeys = {
    {"Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"}
    {"A", "S", "D", "F", "G", "H", "J", "K", "L"}
    {"<", "Z", "X", "C", "V", "B", "N", "M", ">"}
}

keyViews = {}

getKeySize = function(keyboardWidth)
{
    keyboardCellSizeX = math.min(60, keyboardWidth / 11)
    return vec2(keyboardCellSizeX, math.max(keyboardCellSizeX, 40))
}

for(y = 0, y < 3, y++)
{
    row = keyboardKeys[y]
    rowCount = table.count(row)

    for(x, char in row)
    {

            rowIndex = y
            columnIndex = x

        keyView = {
            id = "key_" + char
            type = "button"
            buttonType = "color"
            alignmentY = "bottom"
            #size = vec2(gridCellSize,gridCellSize)
            color = squareBackgroundColor
            onParentSizeChanged = function(parentSize, view)
            {
                keySize = getKeySize(parentSize.x)
                xBaseOffset = ((-rowCount) * (keySize.x + padding) + padding) * 0.5
                xOffset = xBaseOffset + columnIndex * (keySize.x + padding)
                yOffset = (keySize.y + padding) * (2 - rowIndex)
                view.pos = vec2(xOffset, yOffset) + keySize * 0.5
                return keySize
            }
            subviews = {
                {
                    id = "text"
                    type = "text"
                    font = "robotoBold"
                    fontSize = 30
                    text = char
                }
            }
        }
        table.insert(keyViews, keyView)
    }
}

gameView = {
    type = "view"
    id = "gameView"
    hidden = true
    subviews = {
        {
            id = "keyboard"
            type = "view"
            alignmentY = "bottom"
            pos = vec2(0,40)
            subviews = keyViews
            onParentSizeChanged = function(parentSize, view)
            {
                keySize = getKeySize(parentSize.x)
                return vec2(parentSize.x, (keySize.y + padding) * 3 + keySize.y * 0.5)
            }
        }
        {
            id = "grid"
            type = "color"
            additiveBlend = true
            alignmentY = "above"
            layoutParentID = "keyboard"
            pos = vec2(0,20)
            size = gridBackgroundSize
            color = gridBackgroundColor
        }

    }
}


mainView = {
    type = "view"
    subviews = {
        highScoresView,
        gameView,
    }
}