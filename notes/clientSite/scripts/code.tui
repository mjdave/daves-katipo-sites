notesArray = database.get("notes")
if(!notesArray)
{
    notesArray = {}
}
notesScrollView = scene.getView("notesScrollView")

loadNoteRows = function()
{
    notesScrollView.removeAllRows()
    for(i, note in notesArray)
    {
        noteView = notesScrollView.addView(scene.noteLayout)
        noteMarkupView = noteView.getView("noteMarkup")
        #noteView.setVariableHeight(true) #in scene.tui
        noteMarkupView.style = {
            textEntry = function(newText)
            {
                #print("got full note text:", newText)
                note.text = newText
                #noteMarkupView.setText(note.text)
                database.set("notes", notesArray)
                noteView.size = vec2(noteView.size.x, noteMarkupView.size.y + 10)
                notesScrollView.dirty = true
            }
            onTextChanged = function(newText)
            {
                #note.text = newText
                #noteMarkupView.setText(note.text)
                #database.set("notes", notesArray)
                noteView.size = vec2(noteView.size.x, noteMarkupView.size.y + 10)
                notesScrollView.dirty = true
            }
        }
        noteMarkupView.setText(note.text)
        noteView.onParentSizeChanged = function(parentSize)
        {
            noteView.size = vec2(parentSize.x, noteMarkupView.size.y + 10)
            noteMarkupView.size = vec2(parentSize.x, noteMarkupView.size.y)
            noteView.size = vec2(parentSize.x, noteMarkupView.size.y + 10) #twice required to adjust for inner markdown view dimension changes
        }

        removeButton = noteView.getView("removeButton")
        removeButton.click = function()
        {
            table.remove(notesArray, i)
            database.set("notes", notesArray)
            loadNoteRows()
        }
    }
}

addNote = function()
{
    note = {
        text = ""
    }
    table.insert(notesArray, note)
    loadNoteRows()
    #noteTextEntry = notesScrollView.addView(scene.noteLayout)
