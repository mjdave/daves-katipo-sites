cardParentSizeChanged = function(parentSize, view)
{
    return scene.cardSize
}

getFontSize = function()
{
    return math.max(math.floor(scene.cardSize.x / 6), 14)
}

cardTextParentSizeChanged = function(parentSize, view)
{
    view.fontSize = getFontSize()
    view.pos = vec3(scene.cardSize.x * 0.04,-scene.cardSize.x * 0.02, 0)
    return parentSize
}

cardTextParentSizeChangedFlipped = function(parentSize, view)
{
    view.fontSize = getFontSize()
    view.pos = vec3(-scene.cardSize.x * 0.04 + scene.cardSize.x,scene.cardSize.x * 0.02 - scene.cardSize.y, 0)
    return parentSize
}

cardImageParentSizeChanged = function(parentSize, view)
{
    #view.pos = vec3(-scene.cardSize.x * 0.4,-scene.cardSize.x * 0.19, 0)
    return vec2(scene.cardSize.x / 8, scene.cardSize.x / 8)
}

cardImageParentSizeChangedFlipped = function(parentSize, view)
{
    #view.pos = vec3(scene.cardSize.x * 0.4,scene.cardSize.x * 0.29, 0)
    return vec2(scene.cardSize.x / 8, scene.cardSize.x / 8)
}

cardBackgroundImageParentSizeChanged = function(parentSize, view)
{
    return vec2(scene.cardSize.x * 0.9, scene.cardSize.y * 0.9)
}


setGoalPos = function(card, goalPos)
{
    if(card.frontView)
    {
        card.goalPos = goalPos
        
        if(!card.frontView.goalPosUpdateSet)
        {
            card.frontView.goalPosUpdateSet = true
            newUpdateFunc = function(dt)
            {
                card.frontView.pos = card.frontView.pos + (card.goalPos - card.frontView.pos) * math.min(dt * 12, 1)
                if(math.length2(card.frontView.pos - card.goalPos) < 0.001)
                {
                    card.frontView.pos = card.goalPos
                    card.frontView.setUpdate(nil)
                    card.frontView.goalPosUpdateSet = false
                }
            }
            card.frontView.setUpdate(newUpdateFunc)
        }
    }
}

getCardLayout = function(card, layoutParentID)
{
    layout = {
        type = "button"
        layoutParentID = layoutParentID,
        buttonType = "image"
        path = "images/card.png"
        onParentSizeChanged = cardParentSizeChanged
        color = vec4(0.9,0.9,0.9,1.0)
        selectedColor = vec4(2.0,2.0,2.0,2.0)
        subviews = {
            {
                id = "cardNumber"
                type = "text"
                alignmentX = "left"
                alignmentY = "top"
                #pos = vec3(-scene.cardSize.x * 0.3,-scene.padding, 0)
                color = card.suit.color * 0.6
                text = card.glyph.glyphText
                font = "roboto"
                fontSize = getFontSize()
                onParentSizeChanged = cardTextParentSizeChanged
            }
            {
                id = "cardNumberFlipped"
                type = "text"
                alignmentX = "left"
                alignmentY = "top"
                rotation = mat3(-1,0,0,0,-1,0,0,0,1)
                #pos = vec3(-scene.cardSize.x * 0.3,-scene.padding, 0)
                color = card.suit.color * 0.6
                text = card.glyph.glyphText
                font = "roboto"
                fontSize = getFontSize()
                onParentSizeChanged = cardTextParentSizeChangedFlipped
            }
            {
                type = "image"
                alignmentX = "center"
                alignmentY = "below"
                layoutParentID = "cardNumber"
                #pos = vec3(-scene.cardSize.x * 0.3,-math.floor(scene.cardSize.x / 4) - scene.padding, 0)
                color = card.suit.color * 0.6
                path = card.suit.imagePath
                onParentSizeChanged = cardImageParentSizeChanged
            }
            {
                type = "image"
                alignmentX = "center"
                alignmentY = "below"
                layoutParentID = "cardNumberFlipped"
                #rotation = mat3(-1,0,0,0,-1,0,0,0,1)
                #pos = vec3(-scene.cardSize.x * 0.3,-math.floor(scene.cardSize.x / 4) - scene.padding, 0)
                color = card.suit.color * 0.6
                path = card.suit.imagePath
                onParentSizeChanged = cardImageParentSizeChangedFlipped
            }
        }
    }

    if(card.glyph.picture)
    {
        backgroundImageViewLayout = {
            type = "image"
            path = card.glyph.picture
            color = card.suit.color * 0.6
            onParentSizeChanged = cardBackgroundImageParentSizeChanged
        }
        table.insert(layout.subviews, 0, backgroundImageViewLayout)
    }

    if(card.glyph.glyphPositions)
    {
        for(i,glyphPos in card.glyph.glyphPositions)
        {
            localGlyphPos = glyphPos
            glyphOnParentSizeChanged = function(parentSize, view)
            {
                view.pos = vec3(scene.cardSize.x * localGlyphPos.x, scene.cardSize.x * localGlyphPos.y, 0)
                return vec2(scene.cardSize.x / 6, scene.cardSize.x / 6)
            }
            glyphLayout = {
                type = "image"
                color = card.suit.color * 0.6
                path = card.suit.imagePath
                onParentSizeChanged = glyphOnParentSizeChanged
            }

            if(localGlyphPos.y < -0.1)
            {
                glyphLayout.rotation = math.rotate(math.pi,vec3(0,0,1))
            }

            table.insert(layout.subviews, glyphLayout)
        }
    }

    return layout
}

#selectedAceIndex = false
#selectedEmptyPiles = {}
#selectedCards = {}

selectedFromCard = false

cardBacksView = false
cardFacesView = false

checkForCompletion = function()
{
    complete = true
    for(i = 0, i < 4, i++)
    {
        if(table.count(aces[i]) != 13)
        {
            .complete = false
        }
    }

    if(complete)
    {
        scene.getView("gameWon").hidden = false
    }
}

clearSelected = function()
{
    if(selectedFromCard and selectedFromCard.frontView and selectedFromCard.frontView.selected)
    {
        selectedFromCard.frontView.setSelected(false)
        if(selectedFromCard.preSelectionGoalPos)
        {
            setGoalPos(selectedFromCard, selectedFromCard.preSelectionGoalPos)
        }
    }
    .selectedFromCard = false
}

turnPileTopCard = function(pileIndex)
{
    pile = field[pileIndex]
    pileCount = table.count(pile)
    if(pileCount)
    {
        pileTopCard = pile[table.count(pile) - 1]
        if(pileTopCard.backView)
        {
            cardBacksView.removeView(pileTopCard.backView)
            pileTopCard.backView = nil
            
            pileViewID = "field" + pileIndex
            pileTopCard.offsetIndex = 0
            cardLayout = getCardLayout(pileTopCard, pileViewID)
            cardView = cardFacesView.addView(cardLayout)
            cardView.rotation = math.rotate(math.cos(math.random() * math.pi * 2.0) * 0.05, vec3(0,0,1))
            cardClick = function()
            {
                cardClicked(pileTopCard)
            }
            cardView.setClickFunction(cardClick)
            pileTopCard.frontView = cardView
        }
    }
}

removeSelectedCardFromPile = function()
{
    fromPileIndex = selectedFromCard.pileIndex
    if(fromPileIndex)
    {
        fromPile = field[fromPileIndex]

        table.remove(fromPile, table.count(fromPile) - 1)
        
        belowCard = selectedFromCard.belowCard
        while(belowCard)
        {
            table.remove(fromPile, table.count(fromPile) - 1)
            .belowCard = belowCard.belowCard
        }

        newFromPileCount = table.count(fromPile)
        if(newFromPileCount > 0)
        {
            newPileTopCard = fromPile[newFromPileCount - 1]
            if(!newPileTopCard.backView)
            {
                newPileTopCard.belowCard = nil
            }
        }
    }
    else #must be from the hand
    {
        handCount = table.count(hand)
        if(!selectedFromCard.inHand or selectedFromCard != hand[handCount - 1])
        {
            error("removeSelectedCardFromPile called with no pile Index not in hand")
        }
        else
        {
            cardBacksView.removeView(selectedFromCard.backView)
            selectedFromCard.backView = nil
            selectedFromCard.inHand = false
            table.remove(hand, handCount - 1)

            if(table.count(hand) > 0)
            {
                newTopHandCard = hand[table.count(hand) - 1]
                cardClick = function()
                {
                    cardClicked(newTopHandCard)
                }
                newTopHandCard.frontView.setClickFunction(cardClick)
            }
        }
    }

}

acePileClicked = function(aceIndex)
{
    if(selectedFromCard and !selectedFromCard.belowCard)
    {
        acesPile = aces[aceIndex]
        
        acePileCount = table.count(acesPile)
        if(acePileCount == selectedFromCard.glyph.number - 1)
        {
            if(acePileCount == 0 or acesPile[0].suit == selectedFromCard.suit)
            {
                if(acePileCount > 0)
                {
                    topCard = acesPile[acePileCount - 1]
                    topCard.frontView.setClickFunction(nil)
                    topCard.frontView.isHover = false
                    topCard.frontView.setSelected(false)
                }

                removeSelectedCardFromPile()

                
                movingCard = selectedFromCard
                clearSelected()

                table.insert(acesPile, movingCard)
                
                movingCard.pileIndex = nil
                movingCard.aceIndex = aceIndex
                acePileView = scene.getView("ace" + aceIndex)
                posOffset = movingCard.frontView.locationRelativeToView(vec2(0,0), acePileView)
                movingCard.frontView.layoutParent = acePileView
                movingCard.frontView.rotation = math.rotate(math.cos(math.random() * math.pi * 2.0) * 0.1, vec3(0,0,1))
                movingCard.frontView.pos = vec3(posOffset.x,posOffset.y,movingCard.frontView.pos.y)
                
                localAceIndex = aceIndex
                newClickFunction = function()
                {
                    acePileClicked(localAceIndex)
                }
                movingCard.frontView.setClickFunction(newClickFunction)
                movingCard.frontView.orderFront()
                movingCard.frontView.setSelected(false)
                setGoalPos(movingCard, vec3(0,0,0))
                
                #table.insert(acesPile, topCard)
                checkForCompletion()
                return true
            }
        }
    }
    clearSelected()
    return false
}

moveAttachedCards = function(movingCard, newLayoutParentView)
{
    belowCard = movingCard.belowCard
    offsetIndex = movingCard.offsetIndex + 1
    while(belowCard)
    {
        newPile = field[movingCard.pileIndex] #assumes we have moved already
        table.insert(newPile, belowCard)
        posOffset = belowCard.frontView.locationRelativeToView(vec2(0,0), newLayoutParentView)
        belowCard.frontView.layoutParent = newLayoutParentView
        belowCard.pileIndex = movingCard.pileIndex
        belowCard.offsetIndex = offsetIndex
        offsetIndex++
        
        belowCard.frontView.pos = vec3(posOffset.x,posOffset.y,belowCard.frontView.pos.y)
        setGoalPos(belowCard, vec3(0,-belowCard.offsetIndex * scene.cardSize.x * 0.25,0))
        #belowCard.frontView.pos = vec3(0,-belowCard.offsetIndex * scene.cardSize.x * 0.25,0) #todo on view size reset
        belowCard.frontView.orderFront()
        .belowCard = belowCard.belowCard
    }
}

emptyPileClicked = function(pileIndex)
{
    if(selectedFromCard and selectedFromCard.glyph.glyphText == "K")
    {
        emptyPile = field[pileIndex]
        
        emptyPileCount = table.count(emptyPile)
        if(emptyPileCount == 0)
        {
            
            removeSelectedCardFromPile()

            movingCard = selectedFromCard
            clearSelected()

            table.insert(emptyPile, movingCard)

            movingCard.pileIndex = pileIndex
            emptyPileView = scene.getView("field" + pileIndex)
            posOffset = movingCard.frontView.locationRelativeToView(vec2(0,0), emptyPileView)
            movingCard.frontView.layoutParent = emptyPileView
            movingCard.offsetIndex = 0

            movingCard.frontView.pos = vec3(posOffset.x,posOffset.y,movingCard.frontView.pos.y)
            setGoalPos(movingCard, vec3(0,0,0))

            movingCard.frontView.rotation = math.rotate(math.cos(math.random() * math.pi * 2.0) * 0.05, vec3(0,0,1))
            
            moveAttachedCards(movingCard, emptyPileView)
        }

        #table.insert(acesPile, topCard)
        clearSelected()
    }

    turnPileTopCard(pileIndex)
}

cardClicked = function(card)
{
    if(selectedFromCard and selectedFromCard == card)
    {
        for(aceIndex = 0, aceIndex < 4, aceIndex++)
        {
            if(acePileClicked(aceIndex))
            {
                return
            }
        }
    }

    if(card.inHand)
    {
        clearSelected()
    }


    if(selectedFromCard and selectedFromCard != card and !card.belowCard)
    {
        if(card.aceIndex)
        {
            acePileClicked(card.aceIndex)
            clearSelected()
            return
        }
        else
        {
            if(card.glyph.number == selectedFromCard.glyph.number + 1 and card.suit.red != selectedFromCard.suit.red)
            {
                removeSelectedCardFromPile()

                moveToPile = field[card.pileIndex]
                
                movingCard = selectedFromCard
                clearSelected()

                card.frontView.isHover = false

                table.insert(moveToPile, movingCard)
                movingCard.pileIndex = card.pileIndex
                moveToPileView = scene.getView("field" + card.pileIndex)
                
                posOffset = movingCard.frontView.locationRelativeToView(vec2(0,0), moveToPileView)

                movingCard.frontView.layoutParent = moveToPileView
                movingCard.offsetIndex = card.offsetIndex + 1
                #movingCard.frontView.pos = vec3(0,-movingCard.offsetIndex * scene.cardSize.x * 0.25,0) #todo on view size reset
                
                movingCard.frontView.pos = vec3(posOffset.x,posOffset.y,movingCard.frontView.pos.y)
                setGoalPos(movingCard, vec3(0,-movingCard.offsetIndex * scene.cardSize.x * 0.25,0)) #todo on view size reset

                movingCard.frontView.rotation = math.rotate(math.cos(math.random() * math.pi * 2.0) * 0.05, vec3(0,0,1))
                movingCard.frontView.orderFront()

                moveAttachedCards(movingCard, moveToPileView)

                card.belowCard = movingCard
                return
            }
        }
    }

    clearSelected()

    card.frontView.setSelected(true)
    card.preSelectionGoalPos = card.goalPos
    if(!card.preSelectionGoalPos)
    {
        card.preSelectionGoalPos = card.frontView.pos
    }
    setGoalPos(card, vec3(card.preSelectionGoalPos.x,card.preSelectionGoalPos.y + scene.cardSize.x * 0.1, scene.cardSize.x * 0.1))
    #table.insert(selectedCards, card)

    .selectedFromCard = card
}

getDeckCardPos = function(cardIndex)
{
    return vec3(0,0,-2 * (cardIndex + 1))
}

getFieldCardColor = function(cardIndex)
{
    return vec4(0.3,0.05,0.15,1.0) * (1.0 - math.min(cardIndex/30, 1))
}

getDeckCardColor = function(cardIndex)
{
    return vec4(0.01,0.1,0.05,1.0) * (1.0 - math.min(cardIndex/30, 1))
}

deckClicked = function()
{
    clearSelected()
    if(table.count(deck) == 0)
    {
        .deck = hand
        .hand = {}
        
        for(i, card in deck)
        {
            if(card.preSelectionGoalPos)
            {
                card.goalPos = card.preSelectionGoalPos
                card.frontView.pos = card.preSelectionGoalPos
            }
            card.frontView.hidden = true
            card.backView.hidden = false
            card.backView.pos = getDeckCardPos(i)
            card.backView.color = getDeckCardColor(i)
        }
        return
    }

    for(i = 0, i < 3, i++)
    {
        topCard = deck[0]
        table.remove(deck, 0)
        deckEmpty = (table.count(deck) == 0)

        topCard.backView.hidden = true
        if(!topCard.frontView)
        {
            cardLayout = getCardLayout(topCard, "hand")
            cardView = cardFacesView.addView(cardLayout)
            topCard.frontView = cardView
        }
        else
        {
            topCard.frontView.hidden = false
        }
        
        topCard.handOffsetIndex = i
        topCard.frontView.pos = vec3(topCard.handOffsetIndex * scene.cardSize.x * (math.random() * 0.1 + 0.15),topCard.handOffsetIndex * scene.cardSize.x * -0.07,0) #todo on view size reset
        topCard.frontView.rotation = math.rotate(math.cos(math.random() * math.pi * 2.0) * 0.05 - i * 0.15 + 0.05, vec3(0,0,1))
        topCard.frontView.orderFront()

        if(i == 2 or deckEmpty)
        {
            cardClick = function()
            {
                cardClicked(topCard)
            }
            topCard.frontView.setClickFunction(cardClick)
        }
        else
        {
            topCard.frontView.setClickFunction(nil)
        }
        
        if(table.count(hand) > 0)
        {
            prevTopHandCard = hand[table.count(hand) - 1]
            prevTopHandCard.frontView.setClickFunction(nil)
        }

        table.insert(hand, topCard)
        topCard.inHand = true

        if(deckEmpty)
        {
            break
        }
    }

    for(i,card in deck)
    {
        card.backView.pos = getDeckCardPos(i)
        card.backView.color = getDeckCardColor(i)
    }
}

katipo.onSiteLoad = function(wasNewDownload, publicData) #wasNewDownload if we just pulled an update of the site. false if we are running from the cache, but now have a connection
{
    .cardFacesView = scene.getView("cardFaces")
    .cardBacksView = scene.getView("cardBacks")
    print("onSiteLoad")
    for(i,suit in suits)
    {
        for(j,glyph in glyphs)
        {
            card = {
                glyph = glyph
                suit = suit
            }
            table.insert(deck, card)
        }
    }
    table.shuffle(deck)

    for(pileIndex=0,pileIndex<7,pileIndex++)
    {
        for(d=pileIndex,d<7,d++)
        {
            lastCardIndex = table.count(deck) - 1
            card = deck[lastCardIndex]
            table.remove(deck, lastCardIndex)
            pile = field[d]
            table.insert(pile, card)
        }

        localPileIndex = pileIndex #tui bug
        pile = field[localPileIndex]
        pileCount = table.count(pile)
        pileViewID = "field" + localPileIndex
        pileView = scene.getView(pileViewID)
        pileClick = function()
        {
            emptyPileClicked(localPileIndex)
        }
        pileView.setClickFunction(pileClick)

        for(i=0,i<pileCount - 1,i++)
        {
            backLayout = {
                type = "image"
                path = "images/card.png"
                layoutParentID = pileViewID
                color = getFieldCardColor(i)
                additiveBlend = true
                onParentSizeChanged = cardParentSizeChanged
                pos = vec3(0,10 * (i + 1),-2 * (i + 1))
            }
            backCard = pile[i]
            backCardView = cardBacksView.addView(backLayout)
            backCardView.rotation = math.rotate(math.cos(math.random() * math.pi * 2.0) * 0.1, vec3(0,0,1))
            backCard.backView = backCardView
            backCard.pileIndex = localPileIndex
        }

        topCard = pile[pileCount - 1]
        topCard.pileIndex = localPileIndex
        topCard.offsetIndex = 0
        cardLayout = getCardLayout(topCard, pileViewID)
        cardView = cardFacesView.addView(cardLayout)
        cardView.rotation = math.rotate(math.cos(math.random() * math.pi * 2.0) * 0.05, vec3(0,0,1))
        cardClick = function()
        {
            cardClicked(topCard)
        }
        cardView.setClickFunction(cardClick)
        topCard.frontView = cardView
    }

    for(aceIndex = 0, aceIndex < 4, aceIndex++)
    {
        localAcePileIndex = aceIndex
        acePileView = scene.getView("ace" + aceIndex)
        pileClick = function()
        {
            acePileClicked(localAcePileIndex)
        }
        acePileView.setClickFunction(pileClick)
    }
    
    deckView = scene.getView("deck")
    deckView.setClickFunction(deckClicked)
    
    for(i=0,i<table.count(deck),i++)
    {
        backLayout = {
            type = "image"
            path = "images/card.png"
            layoutParentID = "deck"
            color = getDeckCardColor(i)
            additiveBlend = true
            onParentSizeChanged = cardParentSizeChanged
            pos = getDeckCardPos(i)
        }
        backCard = deck[i]
        backCardView = cardBacksView.addView(backLayout)
        backCardView.rotation = math.rotate(math.cos(math.random() * math.pi * 2.0) * 0.1, vec3(0,0,1))
        backCard.backView = backCardView
    }

    .dealIndex = 0
}

katipo.update = function(dt) #called every rendered frame, the variable time step is stored in dt
{

}